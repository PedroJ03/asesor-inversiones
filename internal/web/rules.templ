package web

import "fmt"

templ Alerts(data AlertsData) {
	<article class="alerts">
		<header class="alerts__header">
			<h1>Alertas</h1>
		</header>
		if data.Error != "" {
			<p class="alerts__error" role="alert">{ data.Error }</p>
		}
		<section class="alerts__section" aria-labelledby="rules-heading">
			<h2 id="rules-heading">Reglas</h2>
			@RuleForm(data.Form)
			@RulesList(data.Rules)
		</section>
		<section class="alerts__section" aria-labelledby="history-heading">
			<h2 id="history-heading">Historial reciente</h2>
			@HistoryList(data.History)
		</section>
	</article>
}

templ RuleForm(form RuleFormData) {
	<form
		method="post"
		action="/alertas/reglas/"
		hx-post="/alertas/reglas/"
		hx-target=".alerts"
		hx-swap="outerHTML"
		class="rule-form"
	>
		<fieldset>
			<legend>Nueva regla</legend>
			<div class="rule-form__row">
				<label for="rule-asset">Activo</label>
				<select id="rule-asset" name="source" required>
					<option value="">Seleccionar…</option>
					for _, opt := range form.Options {
						<option value={ opt.Source + "|" + opt.Symbol } selected?={ form.Source == opt.Source && form.Symbol == opt.Symbol }>
							{ opt.Label } ({ opt.Source }/{ opt.Symbol })
						</option>
					}
				</select>
			</div>
			<div class="rule-form__row rule-form__inline">
				<div>
					<label for="rule-kind">Tipo</label>
					<select id="rule-kind" name="kind" required>
						<option value="">Seleccionar…</option>
						<option value="value" selected?={ form.Kind == "value" }>Valor</option>
						<option value="pct" selected?={ form.Kind == "pct" }>Porcentaje</option>
					</select>
				</div>
				<div>
					<label for="rule-direction">Dirección</label>
					<select id="rule-direction" name="direction" required>
						<option value="">Seleccionar…</option>
						<option value="above" selected?={ form.Direction == "above" }>Mayor a</option>
						<option value="below" selected?={ form.Direction == "below" }>Menor a</option>
					</select>
				</div>
				<div>
					<label for="rule-threshold">Umbral</label>
					<input id="rule-threshold" type="text" inputmode="decimal" name="threshold" value={ form.Threshold } required/>
				</div>
			</div>
			if form.Error != "" {
				<p class="rule-form__error" role="alert">{ form.Error }</p>
			}
			<div class="rule-form__actions">
				<button type="submit">Crear regla</button>
			</div>
		</fieldset>
	</form>
}

templ RulesList(rules []RuleView) {
	<div id="rules-list" class="rules-list">
		if len(rules) == 0 {
			<p class="rules-list__empty">No hay reglas configuradas.</p>
		} else {
			<ul class="rules-list__items">
				for _, rule := range rules {
					<li class="rule-card">
						<div class="rule-card__main">
							<span class="rule-card__label">{ rule.Label }</span>
							<span class={ "rule-card__state", rule.StateClass }>{ rule.State }</span>
							if !rule.Enabled {
								<span class={ "rule-card__state", rule.EnabledClass }>deshabilitada</span>
							}
						</div>
						<div class="rule-card__details">
							<span>{ rule.Direction } { rule.Threshold }</span>
							if rule.Kind == "porcentaje" {
								<span>base { rule.BaselinePrice }</span>
							}
						</div>
						<div class="rule-card__actions">
							if rule.Enabled {
								<button
									type="button"
									class="button button--small"
									hx-put={ fmt.Sprintf("/alertas/reglas/%d", rule.ID) }
									hx-vals='{"enabled":"false"}'
									hx-target=".alerts"
									hx-swap="outerHTML"
								>
									Deshabilitar
								</button>
								<form
									method="post"
									action={ templ.SafeURL(fmt.Sprintf("/alertas/reglas/%d", rule.ID)) }
									class="rule-card__disable-form"
								>
									<input type="hidden" name="action" value="deshabilitar"/>
									<noscript>
										<button type="submit" class="button button--small">Deshabilitar</button>
									</noscript>
								</form>
							} else {
								<button
									type="button"
									class="button button--small"
									hx-put={ fmt.Sprintf("/alertas/reglas/%d", rule.ID) }
									hx-vals='{"enabled":"true"}'
									hx-target=".alerts"
									hx-swap="outerHTML"
								>
									Reactivar
								</button>
								<form
									method="post"
									action={ templ.SafeURL(fmt.Sprintf("/alertas/reglas/%d", rule.ID)) }
									class="rule-card__enable-form"
								>
									<input type="hidden" name="action" value="habilitar"/>
									<noscript>
										<button type="submit" class="button button--small">Reactivar</button>
									</noscript>
								</form>
							}
							<form
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/alertas/reglas/%d", rule.ID)) }
								hx-delete={ fmt.Sprintf("/alertas/reglas/%d", rule.ID) }
								hx-target=".alerts"
								hx-swap="outerHTML"
								class="rule-card__delete-form"
							>
								<input type="hidden" name="action" value="eliminar"/>
								<button type="submit" class="button button--small button--danger">Eliminar</button>
							</form>
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

templ HistoryList(history []AlertView) {
	<div id="history-list" class="history-list">
		if len(history) == 0 {
			<p class="history-list__empty">Sin alertas recientes.</p>
		} else {
			<ul class="history-list__items">
				for _, a := range history {
					<li class="history-row history-row--alert">
						<span>{ a.Source }/{ a.Symbol }</span>
						<span>{ a.Kind } { a.Threshold }</span>
						<time>{ a.TriggeredAt }</time>
					</li>
				}
			</ul>
		}
	</div>
}
