package web

import "net/http"

// RequestIsHX reports whether the request was issued by htmx.
func RequestIsHX(r *http.Request) bool {
	return r.Header.Get("HX-Request") == "true"
}

templ Shell(title string, current string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · asesor helper</title>
			<link rel="stylesheet" href="/assets/main.css"/>
			<meta name="theme-color" content="#0f172a"/>
		</head>
		<body>
			<div class="shell">
				<header class="topbar">
					<a href="/" class="brand">asesor helper</a>
				</header>
				<main id="main" class="main">
					@body
				</main>
				@Nav(current)
			</div>
		</body>
	</html>
}

templ Fragment(body templ.Component) {
	@body
}

templ Nav(current string) {
	<nav class="nav" aria-label="Principal">
		<a href="/" class={ navItemClass(current, "inicio") } aria-current={ navAriaCurrent(current, "inicio") }>
			<span class="nav__icon" aria-hidden="true">🏠</span>
			<span class="nav__label">Inicio</span>
		</a>
		<a href="/reporte" class={ navItemClass(current, "reporte") } aria-current={ navAriaCurrent(current, "reporte") }>
			<span class="nav__icon" aria-hidden="true">📊</span>
			<span class="nav__label">Reporte</span>
		</a>
		<a href="/activos" class={ navItemClass(current, "activos") } aria-current={ navAriaCurrent(current, "activos") }>
			<span class="nav__icon" aria-hidden="true">💼</span>
			<span class="nav__label">Activos</span>
		</a>
		<a href="/alertas" class={ navItemClass(current, "alertas") } aria-current={ navAriaCurrent(current, "alertas") }>
			<span class="nav__icon" aria-hidden="true">🔔</span>
			<span class="nav__label">Alertas</span>
		</a>
	</nav>
}

templ LoginPage(errorMsg string) {
	<div class="login">
		<h1>asesor helper</h1>
		<p>Iniciá sesión para ver tus cotizaciones y alertas.</p>
		<form method="post" action="/login" class="login__form">
			<label for="password">Contraseña</label>
			<input type="password" id="password" name="password" required autofocus/>
			if errorMsg != "" {
				<p class="login__error" role="alert">{ errorMsg }</p>
			}
			<button type="submit">Ingresar</button>
		</form>
	</div>
}

func navItemClass(current, name string) string {
	if current == name {
		return "nav__item nav__item--active"
	}
	return "nav__item"
}

func navAriaCurrent(current, name string) string {
	if current == name {
		return "page"
	}
	return "false"
}

templ PlaceholderPage(title string) {
	<article class="placeholder">
		<h1>{ title }</h1>
		<p>Esta sección se encuentra en construcción.</p>
	</article>
}
